# Scabby environment variables — development defaults.
#
# Copy this file to `.env` and adjust as needed. Every variable is optional and
# falls back to a built-in default when unset.
#
#   cp .env.example .env
#
# `SCABBY_DATABASE_URL` carries credentials, so `.env` (unlike this example file)
# is a secret and must never be committed. Add it to .gitignore before you put a
# real password in it.

# PostgreSQL connection string used by sqlx.
# Matches the `postgres` service in docker-compose.yml.
SCABBY_DATABASE_URL=postgres://scabby:scabby@localhost:5432/scabby

# Address the HTTP server binds to.
SCABBY_LISTEN=127.0.0.1:3000

# Directory holding on-disk git repositories and other runtime state.
SCABBY_DATA_DIR=./data

# Public base URL; used to build absolute links (clone URLs, redirects).
SCABBY_BASE_URL=http://localhost:3000

# Who may create accounts: `open` or `closed`.
SCABBY_REGISTRATION=open

# Serve the UI from this directory instead of the copy embedded in the binary.
# Set it while working on the SvelteKit app (point it at web/build); leave it
# unset in production so the embedded assets are used.
# SCABBY_FRONTEND_DIR=./web/build
